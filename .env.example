PORT=4317
DATABASE_PATH=./data/workbench.db
APP_ORIGIN=http://localhost:5173

LINEAR_API_KEY=

# Inbound (Slack -> Workbench): OAuth for the hosted Slack MCP source connection.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4317/api/source-connections/slack/oauth/callback

# Outbound (Workbench -> Slack): pick ONE delivery mode.
# Mode A - bot token. Needs chat:write, and the bot must be invited to the channel.
# SLACK_BOT_TOKEN is also used to expand Slack permalinks into task drafts.
SLACK_BOT_TOKEN=
SLACK_NOTIFY_CHANNEL=
# Mode B - incoming webhook, bound to one channel by Slack. Used only when mode A is unset.
SLACK_WEBHOOK_URL=

# Shared secret gating every inbound request. Leave empty for localhost-only work;
# set it (npm run share generates one) before exposing Workbench over a tunnel.
WORKBENCH_TOKEN=
# Optional cost controls. Codex keeps the account default model at low reasoning
# effort; Claude defaults to Sonnet at low effort.
WORKBENCH_CODEX_MODEL=
WORKBENCH_CLAUDE_MODEL=sonnet

# Stable public hostname for `npm run share`. Set ONE of these, or neither for a
# random Cloudflare quick-tunnel hostname.
NGROK_DOMAIN=
TUNNEL_HOSTNAME=

# --- Slack (outbound notifications) ---
# Preferred: a Workflow Builder webhook trigger. Any Slack member can create one from the
# Slack UI, so it needs no Slack app, no admin approval, and no bot token.
# Slack UI -> Automations -> New Workflow -> start "From a webhook" -> add a text variable
# named `text` -> add a "Send a message to a channel" step that inserts that variable ->
# Publish -> copy the trigger URL.
SLACK_WORKFLOW_URL=https://hooks.slack.com/triggers/T00000000/0000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only if the workflow variable is not named `text`:
# SLACK_WORKFLOW_TEXT_VARIABLE=message
