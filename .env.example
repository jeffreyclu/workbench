PORT=4317
# Public port used by the promoted Workbench runtime and its ngrok tunnel.
# Keep this separate from a sibling project's development port.
WORKBENCH_RUNTIME_PORT=5180
DATABASE_PATH=./data/workbench.db
# Comma-separated extra roots for artifacts outside the task repo. The parent
# directory containing Workbench and its sibling repositories is allowed by default.
WORKBENCH_ARTIFACT_ROOTS=
APP_ORIGIN=http://localhost:5180

LINEAR_API_KEY=

# Kill switch for the structured memory feature (Phase 1). Set to "1" to stop
# reading/writing memories and fall back to the pre-memory prompt context —
# use this if a bad memory is poisoning agent prompts.
WORKBENCH_MEMORY_DISABLED=

# Inbound (Slack -> Workbench): OAuth for the hosted Slack MCP source connection.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4317/api/source-connections/slack/oauth/callback

# Outbound (Workbench -> Slack): pick ONE delivery mode.
# Mode A - bot token. Needs chat:write, and the bot must be invited to the channel.
# SLACK_BOT_TOKEN is also used to expand Slack permalinks into task drafts.
SLACK_BOT_TOKEN=
SLACK_NOTIFY_CHANNEL=
# Mode B - incoming webhook, bound to one channel by Slack. Used only when mode A is unset.
SLACK_WEBHOOK_URL=

# Shared secret gating every inbound request. Leave empty for localhost-only work;
# set it (npm run share generates one) before exposing Workbench over a tunnel.
WORKBENCH_TOKEN=
# Comma-separated CIDR entries (e.g. 127.0.0.1/32,::1/128) naming the reverse
# proxies Workbench trusts to set X-Forwarded-For/X-Forwarded-Proto — typically
# the tunnel process itself, reachable over loopback. Only a request whose
# immediate TCP peer matches one of these gets its forwarded headers honored;
# every other peer's forwarded headers are ignored. Leave empty to trust none.
WORKBENCH_TRUSTED_PROXIES=
# Public origin for OAuth callback URLs (e.g. https://your-tunnel.example.com),
# used only for building the source-connection MCP OAuth redirect. Must be an
# absolute http(s) URL; leave empty to use the fixed local API origin instead.
APP_API_ORIGIN=
# --- Palmyra (Writer's hosted inference API) ---
# A Writer AI Studio API key. When set, Workbench's fast structured-JSON turns
# (currently task drafting) call Palmyra over HTTPS instead of spawning an
# agent CLI subprocess; the Claude worker stays as the automatic fallback.
WRITER_API_KEY=
# Defaults to palmyra-x5. Set to another model your Writer org can serve.
WORKBENCH_PALMYRA_MODEL=

# Optional global model overrides. Per-tier overrides take precedence.
WORKBENCH_CODEX_MODEL=
WORKBENCH_CLAUDE_MODEL=
WORKBENCH_CODEX_MODEL_ECONOMY=gpt-5.6-luna
WORKBENCH_CODEX_MODEL_STANDARD=gpt-5.6-terra
WORKBENCH_CODEX_MODEL_DEEP=gpt-5.6-sol
WORKBENCH_CLAUDE_MODEL_ECONOMY=haiku
WORKBENCH_CLAUDE_MODEL_STANDARD=sonnet
WORKBENCH_CLAUDE_MODEL_DEEP=opus

# --- Claude per-run circuit breaker ---
# A Claude invocation is terminated as soon as its streamed usage crosses either
# limit. Cache-read and cache-write tokens count toward the token limit. These
# are safety bounds for one runaway run, independent of weekly usage reporting.
# Leave unset for the conservative defaults: 1,000,000 tokens or $2 estimated.
# WORKBENCH_CLAUDE_RUN_MAX_TOKENS=1000000
# WORKBENCH_CLAUDE_RUN_MAX_COST_USD=2

# Stable public hostname for `npm run share`. Set ONE of these, or neither for a
# random Cloudflare quick-tunnel hostname.
NGROK_DOMAIN=
TUNNEL_HOSTNAME=

# Read-only artifact publishing. The Pages project can use a neutral custom domain.
ARTIFACT_PAGES_PROJECT=
ARTIFACT_PUBLIC_BASE_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional override for the public Workbench hostname used by shared-page feedback.
# APP_API_ORIGIN is used by default. Feedback posts back without a token, so leave both
# origins empty to keep shared pages read-only.
WORKBENCH_PUBLIC_URL=

# --- Slack (outbound notifications) ---
# Preferred: a Workflow Builder webhook trigger. Any Slack member can create one from the
# Slack UI, so it needs no Slack app, no admin approval, and no bot token.
# Slack UI -> Automations -> New Workflow -> start "From a webhook" -> add a text variable
# named `text` -> add a "Send a message to a channel" step that inserts that variable ->
# Publish -> copy the trigger URL.
SLACK_WORKFLOW_URL=https://hooks.slack.com/triggers/T00000000/0000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only if the workflow variable is not named `text`:
# SLACK_WORKFLOW_TEXT_VARIABLE=message

# --- Cost estimation ---
# Costs are estimated per model, in USD per million tokens. Nothing here is
# required: unset models fall back to the built-in list-price table in
# src/server/model-pricing.ts, and Claude runs prefer the provider's own reported
# total when the CLI supplies one.
#
# Override a single model. The suffix is the model name uppercased with every
# non-alphanumeric character replaced by an underscore (gpt-5.6-terra -> GPT_5_6_TERRA).
# WORKBENCH_MODEL_GPT_5_6_TERRA_INPUT_TOKEN_USD_PER_MILLION=1.25
# WORKBENCH_MODEL_GPT_5_6_TERRA_OUTPUT_TOKEN_USD_PER_MILLION=10
#
# Override every model an agent runs, used only when no per-model rate matches.
# WORKBENCH_CODEX_INPUT_TOKEN_USD_PER_MILLION=1.25
# WORKBENCH_CODEX_OUTPUT_TOKEN_USD_PER_MILLION=10
