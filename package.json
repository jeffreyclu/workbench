{
  "name": "workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx src/server/index.ts",
    "dev:web": "vite",
    "dev:lan": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web:lan\"",
    "dev:web:lan": "vite --host",
    "share": "tsx scripts/share-local.ts",
    "share:workbench": "tsx scripts/share.ts",
    "runtime:promote": "tsx scripts/promote-runtime.ts",
    "runtime:start": "tsx scripts/start-runtime.ts",
    "runtime:install-supervisor": "zsh scripts/install-runtime-supervisor.sh",
    "preview:install-supervisor": "zsh scripts/install-preview-supervisor.sh",
    "ngrok:install-supervisor": "zsh scripts/install-ngrok-supervisor.sh",
    "preview": "npm run preview:web",
    "preview:sandbox": "concurrently -k -n preview-api,preview-web -c cyan,magenta \"npm:preview:api\" \"WORKBENCH_API_TARGET=http://127.0.0.1:45175 vite --port 5181\"",
    "preview:api": "PORT=45175 tsx watch scripts/preview-api.ts",
    "preview:web": "WORKBENCH_API_TARGET=http://127.0.0.1:5180 WORKBENCH_PREVIEW_READ_ONLY=1 vite --port 5181",
    "e2e": "playwright test",
    "e2e:api": "PORT=45176 node --import tsx scripts/e2e-api.ts",
    "e2e:web": "WORKBENCH_API_TARGET=http://127.0.0.1:45176 WORKBENCH_VITE_CACHE_DIR=/private/tmp/workbench-e2e-vite vite --configLoader runner --port 5175 --host 127.0.0.1",
    "e2e:serve": "concurrently -k -n e2e-api,e2e-web -c cyan,magenta \"npm:e2e:api\" \"npm:e2e:web\"",
    "memory:index": "tsx scripts/index-memory.ts",
    "discovery:scan": "tsx scripts/discover.ts --force",
    "backup:run": "tsx scripts/backup.ts",
    "backup:install": "zsh scripts/install-backup-schedule.sh",
    "build": "tsc -b && vite build && tsx scripts/bundle-size-report.ts",
    "report:bundle-size": "tsx scripts/bundle-size-report.ts",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/markdown": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-virtual": "^3.14.10",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lexical": "^0.49.0",
    "lucide-react": "^0.539.0",
    "marked": "^18.0.10",
    "prismjs": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "undici": "^7.29.0",
    "ws": "^8.21.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
