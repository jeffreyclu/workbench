{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["scripts", "src/server", "src/shared", "vite.config.ts", "vitest.config.ts", "eslint.config.js"]
}
